# Copy to .env (or set in your host's dashboard) and fill in real values.

# Per-device API keys for the data-ingestion endpoint
# POST /api/flights/{flight_id}/data, headers X-Device-Id + X-Api-Key.
# Format: "deviceId1:secret1,deviceId2:secret2"
# Leave unset to disable ingestion (the endpoint then returns 503).
PILOTSENSE_DEVICE_KEYS=

# Port the server binds to (most PaaS hosts inject this automatically).
PORT=8000
